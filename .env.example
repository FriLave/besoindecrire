# Database connection string
DATABASE_URL=postgres://payload:payload@127.0.0.1:5432/payload

# Or use a PG connection string
#DATABASE_URL=postgresql://127.0.0.1:5432/your-database-name

# Used to encrypt JWT tokens
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Used to configure CORS, format links and more. No trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Used to validate preview requests
PREVIEW_SECRET=YOUR_SECRET_HERE

# Email (optional). If SMTP_HOST is unset, Payload logs emails to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=

# Payments module (Stripe Checkout, redirect mode: no publishable key needed)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Vercel uniquement: secret du cron Vercel (Authorization: Bearer) pour /api/payload-jobs/run
CRON_SECRET=

# Backups (docker-compose.prod.yml `backup` service). Default: daily dump to the `backups` volume.
# Set BACKUP_S3_BUCKET to upload to S3-compatible storage instead (no local copy kept).
#BACKUP_CRON=0 2 * * *
#BACKUP_RETENTION_DAYS=30
#BACKUP_S3_BUCKET=
#BACKUP_S3_ENDPOINT=
#BACKUP_S3_REGION=
#BACKUP_S3_ACCESS_KEY_ID=
#BACKUP_S3_SECRET_ACCESS_KEY=
#BACKUP_S3_PREFIX=

# File storage. local (default: disk) | s3 | vercel-blob. See README "Stockage des fichiers".
STORAGE_DRIVER=local
# Optional: driver for paid files (private-files). Defaults to STORAGE_DRIVER.
# Vercel Blob has no private blobs: with the payments module use STORAGE_DRIVER_PRIVATE=s3.
#STORAGE_DRIVER_PRIVATE=
# vercel-blob
#BLOB_READ_WRITE_TOKEN=
# s3: AWS, Cloudflare R2, Scaleway, OVH, Garage, MinIO...
#S3_BUCKET=
# Optional: separate bucket for paid files. Default: same bucket, under the private-files/ prefix.
#S3_PRIVATE_BUCKET=
# Omit for AWS
#S3_ENDPOINT=
#S3_REGION=
#S3_ACCESS_KEY_ID=
#S3_SECRET_ACCESS_KEY=
# true for Garage / MinIO
#S3_FORCE_PATH_STYLE=
# Optional public base URL of the media bucket (CDN, R2 public domain). Set: media is served directly from it.
# Unset: media is served through Payload (/api/media/file/...). Paid files are never served directly.
#S3_PUBLIC_URL=

# Garage (self-hosted blob storage, docker-compose.prod.yml --profile storage): openssl rand -hex 32
# GARAGE_RPC_SECRET=
